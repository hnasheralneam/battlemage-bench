<%
function isActive(href) {
  const path = typeof currentPath !== 'undefined' ? currentPath : '';
  if (href === '/') return path === '/';
  if (href === '/results') return path === '/results' || path.startsWith('/configs/');
  if (href === '/recipes') return path === '/recipes' || path.startsWith('/recipes/');
  return path === href;
}
%>
<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="/"><span class="brand-mark">BM</span>Battlemage Benchmarks</a>
    <nav class="site-nav">
      <a href="/" class="<%= isActive('/') ? 'active' : '' %>">Home</a>
      <a href="/results" class="<%= isActive('/results') ? 'active' : '' %>">Results</a>
      <a href="/compare" class="<%= isActive('/compare') ? 'active' : '' %>">Compare</a>
      <a href="/recipes" class="<%= isActive('/recipes') ? 'active' : '' %>">Recipes</a>
      <a href="/methodology" class="<%= isActive('/methodology') ? 'active' : '' %>">Methodology</a>
      <a href="/submit" class="<%= isActive('/submit') ? 'active' : '' %>">Submit a result</a>
    </nav>
    <button type="button" id="theme-toggle-btn" class="theme-toggle" aria-pressed="false" aria-label="Switch to dark theme">
      <svg class="theme-toggle-icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path></svg>
      <svg class="theme-toggle-icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
    </button>
  </div>
</header>
